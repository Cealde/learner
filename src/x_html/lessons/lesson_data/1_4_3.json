{
  "title": "Multiplication, Division & Precedence",
  "subtitle": "Operators and Order of Operations",
  "topic": "3.1 • MULTIPLICATION & DIVISION",
  "body": "<div style=\"display: flex; flex-direction: column; gap: 18px; width: 100%;\">\n  <div style=\"text-align: center; margin-bottom: 4px; width: 100%;\">\n    <div style=\"display: inline-block; background-color: #ffffff; border: 3px solid #111111; box-shadow: 4px 4px 0px #111111; padding: 4px 14px; margin-bottom: 10px; font-weight: 900; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;\">\n      3.1 • Advanced Operators\n    </div>\n    <h1 style=\"font-family: 'Title', 'Body', sans-serif; font-size: 30px; font-weight: 900; color: #111111; margin: 0 0 8px 0; text-transform: uppercase;\">\n      Multiplication, <hlt>Division</hlt> & Precedence\n    </h1>\n    <p style=\"font-size: 15px; font-weight: 600; color: #222222; margin: 0 auto; max-width: 640px;\">\n      Python uses <code>*</code> for multiplication and <code>/</code> for division. Understanding operator precedence ensures calculations run in the exact order you intend.\n    </p>\n  </div>\n\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px;\">\n    <div style=\"background: #86efac; border: 3px solid #111111; box-shadow: 5px 5px 0px #111111; border-radius: 4px; padding: 18px;\">\n      <span style=\"display: inline-block; background-color: #ffffff; color: #111111; border: 2px solid #111111; box-shadow: 2px 2px 0px #111111; padding: 2px 8px; font-size: 11px; font-weight: 900; text-transform: uppercase; margin-bottom: 8px;\">\n        Multiplication (*)\n      </span>\n      <h3 style=\"font-family: 'Title', 'Body', sans-serif; font-size: 18px; font-weight: 900; color: #111111; margin: 0 0 8px 0;\">ASTERISK OPERATOR</h3>\n      <p style=\"font-size: 14px; font-weight: 600; color: #111111; margin-bottom: 10px; line-height: 1.4;\">\n        Multiplies two numeric values together.\n      </p>\n      <div style=\"background: #0d1117; border: 2px solid #111111; padding: 10px; font-family: 'Consolas', monospace; color: #f0f6fc; font-size: 13px; border-radius: 4px;\">\n        length = <span style=\"color: #7ee787;\">10</span><br/>\n        width = <span style=\"color: #7ee787;\">5</span><br/>\n        area = length * width<br/>\n        <span style=\"color: #79c0ff;\">print</span>(area)  <span style=\"color: #8b949e;\"># Outputs: 50</span>\n      </div>\n    </div>\n\n    <div style=\"background: #c4b5fd; border: 3px solid #111111; box-shadow: 5px 5px 0px #111111; border-radius: 4px; padding: 18px;\">\n      <span style=\"display: inline-block; background-color: #ffffff; color: #111111; border: 2px solid #111111; box-shadow: 2px 2px 0px #111111; padding: 2px 8px; font-size: 11px; font-weight: 900; text-transform: uppercase; margin-bottom: 8px;\">\n        Division (/) • Float Result\n      </span>\n      <h3 style=\"font-family: 'Title', 'Body', sans-serif; font-size: 18px; font-weight: 900; color: #111111; margin: 0 0 8px 0;\">SLASH OPERATOR</h3>\n      <p style=\"font-size: 14px; font-weight: 600; color: #111111; margin-bottom: 10px; line-height: 1.4;\">\n        Single slash <code>/</code> <strong>always</strong> returns a decimal float.\n      </p>\n      <div style=\"background: #0d1117; border: 2px solid #111111; padding: 10px; font-family: 'Consolas', monospace; color: #f0f6fc; font-size: 13px; border-radius: 4px;\">\n        total = <span style=\"color: #7ee787;\">100</span><br/>\n        players = <span style=\"color: #7ee787;\">4</span><br/>\n        each = total / players<br/>\n        <span style=\"color: #79c0ff;\">print</span>(each)  <span style=\"color: #8b949e;\"># Outputs: 25.0</span>\n      </div>\n    </div>\n  </div>\n\n  <div style=\"background: #fde047; border: 3px solid #111111; box-shadow: 6px 6px 0px #111111; border-radius: 4px; padding: 20px;\">\n    <span style=\"display: inline-block; background-color: #ffffff; color: #111111; border: 2px solid #111111; box-shadow: 2px 2px 0px #111111; padding: 2px 8px; font-size: 11px; font-weight: 900; text-transform: uppercase; margin-bottom: 8px;\">\n      Operator Precedence • BODMAS / PEMDAS\n    </span>\n    <h2 style=\"font-family: 'Title', 'Body', sans-serif; font-size: 20px; font-weight: 900; color: #111111; margin: 0 0 10px 0; text-transform: uppercase;\">\n      Which Operator Executes First?\n    </h2>\n    <div style=\"display: flex; gap: 10px; margin-bottom: 12px; flex-wrap: wrap;\">\n      <div style=\"background: #ffffff; border: 2px solid #111111; padding: 6px 12px; font-weight: 800; font-size: 13px; box-shadow: 2px 2px 0 #111111;\">\n        1. Brackets ()\n      </div>\n      <div style=\"background: #ffffff; border: 2px solid #111111; padding: 6px 12px; font-weight: 800; font-size: 13px; box-shadow: 2px 2px 0 #111111;\">\n        2. Multiply * & Divide /\n      </div>\n      <div style=\"background: #ffffff; border: 2px solid #111111; padding: 6px 12px; font-weight: 800; font-size: 13px; box-shadow: 2px 2px 0 #111111;\">\n        3. Add + & Subtract -\n      </div>\n    </div>\n\n    <div style=\"background: #0d1117; border: 2px solid #111111; box-shadow: 3px 3px 0 #111111; padding: 12px 14px; font-family: 'Consolas', monospace; color: #f0f6fc; font-size: 14px; border-radius: 4px;\">\n      <span style=\"color: #8b949e;\"># Without brackets: 50 / 2 executes FIRST</span><br/>\n      <span style=\"color: #79c0ff;\">print</span>(<span style=\"color: #7ee787;\">10</span> + <span style=\"color: #7ee787;\">50</span> / <span style=\"color: #7ee787;\">2</span>)    <span style=\"color: #8b949e;\"># 10 + 25.0 = 35.0</span><br/><br/>\n      <span style=\"color: #8b949e;\"># With brackets: (10 + 50) executes FIRST</span><br/>\n      <span style=\"color: #79c0ff;\">print</span>((<span style=\"color: #7ee787;\">10</span> + <span style=\"color: #7ee787;\">50</span>) / <span style=\"color: #7ee787;\">2</span>)  <span style=\"color: #8b949e;\"># 60 / 2 = 30.0</span>\n    </div>\n  </div>\n</div>"
}