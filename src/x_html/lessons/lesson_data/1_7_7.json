{
  "title": "Why Use Functions? — DRY & Modularity",
  "subtitle": "Don't Repeat Yourself, Clean Architecture & Local Scope",
  "topic": "6.2 • WHY USE FUNCTIONS?",
  "body": "<div style=\"display: flex; flex-direction: column; gap: 18px; width: 100%;\">\n  <div style=\"text-align: center; margin-bottom: 4px; width: 100%;\">\n    <div style=\"display: inline-block; background-color: #ffffff; border: 3px solid #111111; box-shadow: 4px 4px 0px #111111; padding: 4px 14px; margin-bottom: 10px; font-weight: 900; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;\">\n      6.2 • Clean Code Principles\n    </div>\n    <h1 style=\"font-family: 'Title', 'Body', sans-serif; font-size: 30px; font-weight: 900; color: #111111; margin: 0 0 8px 0; text-transform: uppercase;\">\n      The <hlt>DRY</hlt> Principle\n    </h1>\n    <p style=\"font-size: 15px; font-weight: 600; color: #222222; margin: 0 auto; max-width: 640px;\">\n      <strong>DRY = Don't Repeat Yourself!</strong> Functions allow you to fix bugs in one place and reuse tested logic across your entire codebase.\n    </p>\n  </div>\n\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px;\">\n    <div style=\"background: #fca5a5; border: 3px solid #111111; box-shadow: 5px 5px 0px #111111; border-radius: 4px; padding: 18px;\">\n      <span style=\"display: inline-block; background-color: #ffffff; color: #111111; border: 2px solid #111111; box-shadow: 2px 2px 0px #111111; padding: 2px 8px; font-size: 11px; font-weight: 900; text-transform: uppercase; margin-bottom: 8px;\">\n        Messy (Repeated)\n      </span>\n      <h3 style=\"font-family: 'Title', 'Body', sans-serif; font-size: 18px; font-weight: 900; color: #111111; margin: 0 0 8px 0;\">Duplicate Calculations</h3>\n      <p style=\"font-size: 14px; font-weight: 600; color: #111111; margin-bottom: 10px;\">Copy-pasting the same 5 lines 10 times makes code hard to maintain.</p>\n    </div>\n\n    <div style=\"background: #86efac; border: 3px solid #111111; box-shadow: 5px 5px 0px #111111; border-radius: 4px; padding: 18px;\">\n      <span style=\"display: inline-block; background-color: #ffffff; color: #111111; border: 2px solid #111111; box-shadow: 2px 2px 0px #111111; padding: 2px 8px; font-size: 11px; font-weight: 900; text-transform: uppercase; margin-bottom: 8px;\">\n        Clean (Modular)\n      </span>\n      <h3 style=\"font-family: 'Title', 'Body', sans-serif; font-size: 18px; font-weight: 900; color: #111111; margin: 0 0 8px 0;\">One Reusable Function</h3>\n      <p style=\"font-size: 14px; font-weight: 600; color: #111111; margin-bottom: 10px;\">Define it once, test it once, and call it cleanly everywhere.</p>\n    </div>\n  </div>\n</div>"
}