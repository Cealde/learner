{
  "title": "List Mutation — append, pop & Slicing",
  "subtitle": "Adding, Removing, and Extracting Subsets",
  "topic": "7.1 • LIST MUTATION & SLICING",
  "body": "<div style=\"display: flex; flex-direction: column; gap: 18px; width: 100%;\">\n  <div style=\"text-align: center; margin-bottom: 4px; width: 100%;\">\n    <div style=\"display: inline-block; background-color: #ffffff; border: 3px solid #111111; box-shadow: 4px 4px 0px #111111; padding: 4px 14px; margin-bottom: 10px; font-weight: 900; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;\">\n      7.1 • Dynamic Modifications\n    </div>\n    <h1 style=\"font-family: 'Title', 'Body', sans-serif; font-size: 30px; font-weight: 900; color: #111111; margin: 0 0 8px 0; text-transform: uppercase;\">\n      List <hlt>Mutation & Slicing</hlt>\n    </h1>\n    <p style=\"font-size: 15px; font-weight: 600; color: #222222; margin: 0 auto; max-width: 640px;\">\n      Lists are mutable: you can add items, remove elements dynamically, and slice out specific portions of data!\n    </p>\n  </div>\n\n  <div style=\"background: #93c5fd; border: 3px solid #111111; box-shadow: 6px 6px 0px #111111; border-radius: 4px; padding: 20px;\">\n    <span style=\"display: inline-block; background-color: #ffffff; color: #111111; border: 2px solid #111111; box-shadow: 2px 2px 0px #111111; padding: 2px 8px; font-size: 11px; font-weight: 900; text-transform: uppercase; margin-bottom: 8px;\">\n      Core List Methods\n    </span>\n    <div style=\"display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px;\">\n      <div style=\"background: #ffffff; border: 2px solid #111111; padding: 10px; font-size: 13px;\">\n        <code>.append(item)</code>: Adds an item to the very end of the list.\n      </div>\n      <div style=\"background: #ffffff; border: 2px solid #111111; padding: 10px; font-size: 13px;\">\n        <code>.pop(index)</code>: Removes and returns the item at that index (default is last item).\n      </div>\n      <div style=\"background: #ffffff; border: 2px solid #111111; padding: 10px; font-size: 13px;\">\n        <code>list[start:stop]</code>: Slices out items from index <code>start</code> up to (excluding) <code>stop</code>.\n      </div>\n    </div>\n    <div style=\"background: #0d1117; border: 2px solid #111111; box-shadow: 3px 3px 0 #111111; padding: 14px; font-family: 'Consolas', monospace; color: #f0f6fc; font-size: 14px; border-radius: 4px;\">\n      cart = [<span style=\"color: #a5d6ff;\">\"Keyboard\"</span>, <span style=\"color: #a5d6ff;\">\"Mouse\"</span>]<br/>\n      cart.append(<span style=\"color: #a5d6ff;\">\"Monitor\"</span>)  <span style=\"color: #8b949e;\"># ['Keyboard', 'Mouse', 'Monitor']</span><br/>\n      removed = cart.pop(<span style=\"color: #7ee787;\">0</span>)     <span style=\"color: #8b949e;\"># Removes 'Keyboard'</span><br/>\n      <span style=\"color: #79c0ff;\">print</span>(cart)                 <span style=\"color: #8b949e;\"># Outputs: ['Mouse', 'Monitor']</span>\n    </div>\n  </div>\n</div>"
}